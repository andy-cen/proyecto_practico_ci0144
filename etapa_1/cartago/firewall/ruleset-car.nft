#!/usr/sbin/nft -f

flush ruleset

table inet filter {

    set lan_ifaces {
        type ifname
        elements = { "ens36.100", "ens36.101", "ens36.102", "ens36.103",
                      "ens36.104", "ens36.105", "ens36.106", "ens36.107", "ens36.108" }
    }

    set wan_ssh_allow {
        type ipv4_addr
        flags interval
        elements = { 172.17.0.115 }
    }

    chain input {
        type filter hook input priority 0; policy drop;

        iif "lo" accept
        ct state established,related accept
        ct state invalid drop

        # ICMP básico
        iifname "ens37" icmp type { echo-request, destination-unreachable, time-exceeded } accept
        iifname @lan_ifaces icmp type { echo-request, destination-unreachable, time-exceeded } accept
        ip protocol icmp icmp type echo-reply accept
        iifname @lan_ifaces udp dport 123 accept
        # ICMP proveniente de SJO
        iifname "ens33" ip saddr 10.4.0.0/20 ip daddr 10.4.32.0/20 icmp type echo-request accept

        # SSH desde VLAN de gestión interna
        iifname "ens36.100" tcp dport 22 ct state new accept

        # SSH desde gestión NAC out-of-band
        iifname "ens37" tcp dport 22 ct state new accept

        # SSH desde WAN excepcion: solo IP permitida con rate limit 
        iifname "ens33" ip saddr @wan_ssh_allow tcp dport 22 ct state new \
            limit rate 4/minute burst 4 packets accept

        # input
	iifname "ens33" ip saddr 172.24.133.76 ip protocol esp accept
	iifname "ens33" ip saddr 172.24.133.80 udp dport { 500, 4500 } accept
	iifname "ens33" ip protocol esp ip saddr 172.24.133.80 accept
	iifname "ens33" ip saddr 10.4.16.0/20 icmp type { echo-request, echo-reply, destination-unreachable, time-exceeded } accept

	limit rate 5/minute log prefix "INPUT-DROP: " level info
        drop
    }

    chain forward {
        type filter hook forward priority 0; policy drop;

        ct state established,related accept
        ct state invalid drop

        # Salida de cualquier VLAN interna hacia Internet
        iifname @lan_ifaces oifname "ens33" accept

        iifname @lan_ifaces oifname @lan_ifaces accept
        iifname @lan_ifaces oifname "ens33" ip daddr 10.4.16.0/20 accept
        iifname "ens33" oifname @lan_ifaces ip saddr 10.4.16.0/20 accept

	iifname @lan_ifaces oifname "ens33" ip daddr 10.4.0.0/20 accept
	iifname "ens33" oifname @lan_ifaces ip saddr 10.4.0.0/20 accept
	iifname "ens33" ip saddr 10.4.16.0/20 ip daddr 10.4.32.0/20 accept

	limit rate 5/minute log prefix "FORWARD-DROP: " level info
        drop
    }

    chain output {
        type filter hook output priority 0; policy drop;

        oif "lo" accept
        oifname "ens33" ip daddr 172.24.133.80 udp dport { 500, 4500 } accept
        oifname "ens33" ip daddr 172.24.133.80 ip protocol esp accept
        ct state established,related accept

        udp dport 53 accept
        tcp dport 53 accept
        udp dport 123 accept
        tcp dport { 80, 443 } accept
        tcp dport 22 accept
        icmp type { echo-request, echo-reply, destination-unreachable, time-exceeded } accept

	oifname "ens33" ip daddr 172.24.133.76 ip protocol esp accept
	ip daddr 172.24.133.80 udp dport { 500, 4500 } accept
	ip protocol esp ip daddr 172.24.133.80 accept

        limit rate 5/minute log prefix "OUTPUT-DROP: " level info
        drop
    }
}

table ip nat {
    chain postrouting {
        type nat hook postrouting priority 100; policy accept;

        # NAT de salida para que todo el bloque de car sale con la IP WAN del firewall
        ip saddr 10.4.32.0/20 ip daddr != { 10.4.0.0/20, 10.4.16.0/20 } oifname "ens33" snat to 172.24.133.84
    }
}
