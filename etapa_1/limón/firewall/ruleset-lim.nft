#!/usr/sbin/nft -f

flush ruleset

table inet filter {

    set lan_ifaces {
        type ifname
        elements = { "ens34.100", "ens34.101", "ens34.102", "ens34.103",
                     "ens34.104", "ens34.105", "ens34.106", "ens34.107",
                     "ens34.108" }
    }

    # IP real de origen de tu VPN institucional
    set wan_ssh_allow {
        type ipv4_addr
        flags interval
        elements = { 172.17.0.120 }
    }

    # WAN de los otros dos extremos de tunel IPsec
    set ipsec_peers {
        type ipv4_addr
        elements = { 172.24.133.76, 172.24.133.84 }
    }

    chain input {
        type filter hook input priority 0; policy drop;

        iif "lo" accept
        ct state established,related accept
        ct state invalid drop

        # ICMP basico para diagnostico
        iifname "ens35" icmp type { echo-request, destination-unreachable, time-exceeded } accept
        iifname @lan_ifaces icmp type { echo-request, destination-unreachable, time-exceeded } accept
        ip protocol icmp icmp type echo-reply accept
        iifname "ens33" ip saddr 172.24.133.76 udp dport { 500, 4500 } accept
        iifname "ens33" ip saddr 172.24.133.76 ip protocol esp accept

        # ICMP proveniente de sjo/car a traves del tunel IPsec
        iifname "ens33" ip saddr { 10.4.0.0/20, 10.4.32.0/20 } ip daddr 10.4.16.0/20 \
            icmp type echo-request accept

        # SSH desde VLAN de gestion interna
        iifname "ens34.100" tcp dport 22 ct state new accept

        # SSH desde gestion NAC out-of-band
        iifname "ens35" tcp dport 22 ct state new accept

        # SSH desde WAN restringido a la IP permitida
        iifname "ens33" ip saddr @wan_ssh_allow tcp dport 22 ct state new \
            limit rate 4/minute burst 4 packets accept

        # IKEv2 (negociacion) desde sjo y car
        iifname "ens33" ip saddr @ipsec_peers udp dport { 500, 4500 } accept

        # ESP entrante desde sjo y car
        iifname "ens33" ip saddr @ipsec_peers ip protocol esp accept

        limit rate 5/minute log prefix "INPUT-DROP: " level info
        drop
    }

    chain forward {
        type filter hook forward priority 0; policy drop;

        ct state established,related accept
        ct state invalid drop

        # Salida de cualquier VLAN interna hacia WAN
        iifname @lan_ifaces oifname "ens33" accept

        # Enrutamiento entre zonas internas
        iifname @lan_ifaces oifname @lan_ifaces accept
        iifname @lan_ifaces oifname "ens33" ip daddr 10.4.0.0/20 accept
        iifname "ens33" oifname @lan_ifaces ip saddr 10.4.0.0/20 accept

        # Trafico desde sjo/car hacia las VLAN internas de Limon
        iifname "ens33" oifname @lan_ifaces ip saddr { 10.4.0.0/20, 10.4.32.0/20 } accept

        limit rate 5/minute log prefix "FORWARD-DROP: " level info
        drop
    }

    chain output {
        type filter hook output priority 0; policy drop;

        oif "lo" accept
        oifname "ens33" ip daddr 172.24.133.76 udp dport { 500, 4500 } accept
        oifname "ens33" ip daddr 172.24.133.76 ip protocol esp accept
        ct state established,related accept

        udp dport 53 accept
        tcp dport 53 accept
        udp dport 123 accept
        tcp dport { 80, 443 } accept
        tcp dport 22 accept
        icmp type { echo-request, echo-reply, destination-unreachable, time-exceeded } accept

        # IKEv2 y ESP saliente hacia sjo y car
        oifname "ens33" ip daddr @ipsec_peers udp dport { 500, 4500 } accept
        oifname "ens33" ip daddr @ipsec_peers ip protocol esp accept

        limit rate 5/minute log prefix "OUTPUT-DROP: " level info
        drop
    }
}

table ip nat {
    chain postrouting {
        type nat hook postrouting priority 100; policy accept;

        ip saddr 10.4.16.0/20 ip daddr != { 10.4.0.0/20, 10.4.32.0/20 } \
            oifname "ens33" snat to 172.24.133.80
    }
}
