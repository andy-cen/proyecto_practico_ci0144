[Unit]
Description=Prometheus Node Exporter
Wants=network-online.target
After=network-online.target

[Service]
User=node_exporter
Group=node_exporter
Type=simple
ExecStart=/usr/local/bin/node_exporter --web.listen-address=10.4.1.20:9100
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
