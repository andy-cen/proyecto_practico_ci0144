table inet filter {
	set lan_ifaces {
		type ifname
		elements = { "ens36.100",
			     "ens36.101",
			     "ens36.102",
			     "ens36.103",
			     "ens36.104",
			     "ens36.105",
			     "ens36.106",
			     "ens36.107",
			     "ens36.108" }
	}

	set management_ifaces {
		type ifname
		elements = { "ens36.100" }
	}

	set internal_server_ifaces {
		type ifname
		elements = { "ens36.101",
			     "ens36.102",
			     "ens36.104" }
	}

	set dmz_ifaces {
		type ifname
		elements = { "ens36.103" }
	}

	set client_ifaces {
		type ifname
		elements = { "ens36.105",
			     "ens36.106",
			     "ens36.107",
			     "ens36.108" }
	}

	set wan_ssh_allow {
		type ipv4_addr
		flags interval
		elements = { 172.17.0.112, 172.17.0.115 }
	}

	chain input {
		type filter hook input priority filter; policy drop;
		ip saddr { 10.4.5.0-10.4.8.255, 10.4.21.0-10.4.24.255, 10.4.37.0-10.4.40.255 } ip daddr 10.4.32.0/24 counter packets 0 bytes 0 drop
		ip saddr 10.4.1.50 tcp dport 9100 accept
		iifname "ens36.105" udp sport 68 udp dport 67 accept
		iif "lo" accept
		ct state established,related accept
		ct state invalid drop
		iifname @client_ifaces ip daddr 10.4.32.0/24 counter packets 45 bytes 3780 drop
		iifname "ens37" icmp type { destination-unreachable, echo-request, time-exceeded } accept
		iifname @lan_ifaces icmp type { destination-unreachable, echo-request, time-exceeded } accept
		ip protocol icmp icmp type echo-reply accept
		iifname @lan_ifaces udp dport 123 accept
		iifname "ens33" ip saddr 172.24.133.80 udp dport { 500, 4500 } accept
		iifname "ens33" ip saddr 172.24.133.80 ip protocol esp accept
		iifname "ens33" ip saddr 10.4.0.0/20 ip daddr 10.4.32.0/20 icmp type echo-request accept
		iifname "ens36.100" tcp dport 22 ct state new accept
		iifname "ens37" tcp dport 22 ct state new accept
		iifname "ens33" ip saddr @wan_ssh_allow tcp dport 22 ct state new limit rate 4/minute burst 4 packets accept
		iifname "ens33" ip saddr 172.24.133.76 ip protocol esp accept
		iifname "ens33" ip saddr 172.24.133.80 udp dport { 500, 4500 } accept
		iifname "ens33" ip protocol esp ip saddr 172.24.133.80 accept
		iifname "ens33" ip saddr 10.4.16.0/20 icmp type { echo-reply, destination-unreachable, echo-request, time-exceeded } accept
             iifname "ens33" ip saddr 10.4.16.1 ip daddr 10.4.33.1 tcp dport 22 ct state new accept
		limit rate 5/minute burst 5 packets log prefix "INPUT-DROP: " level info
		drop
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
		ip saddr { 10.4.5.0-10.4.8.255, 10.4.21.0-10.4.24.255, 10.4.37.0-10.4.40.255 } ip daddr 10.4.32.0/24 counter packets 0 bytes 0 drop
		iifname "ens36.101" oifname "ens36.103" ip saddr 10.4.33.50 ip daddr 10.4.35.20 tcp dport 22 accept
		iifname "ens36.101" oifname "ens36.103" ip saddr 10.4.33.50 ip daddr 10.4.35.20 tcp dport 53 accept
		iifname "ens36.101" oifname "ens36.103" ip saddr 10.4.33.50 ip daddr 10.4.35.20 udp dport 53 accept
		ct state established,related accept
		ct state invalid drop
		iifname "ens36.105" oifname "ens36.103" ip saddr 10.4.37.0/24 ip daddr 10.4.35.20 udp dport 53 accept
		iifname "ens36.105" oifname "ens36.103" ip saddr 10.4.37.0/24 ip daddr 10.4.35.20 tcp dport 53 accept
		iifname @client_ifaces oifname @management_ifaces counter packets 0 bytes 0 drop
		iifname @management_ifaces oifname @internal_server_ifaces counter packets 0 bytes 0 accept
		iifname @management_ifaces oifname @dmz_ifaces counter packets 0 bytes 0 accept
		iifname @management_ifaces oifname @client_ifaces counter packets 0 bytes 0 accept
		iifname @lan_ifaces oifname "ens33" accept
		iifname "ens33" oifname @lan_ifaces ip saddr { 10.4.0.0/19 } ip daddr 10.4.32.0/20 accept
		limit rate 5/minute burst 5 packets log prefix "FORWARD-DROP: " level info
		drop
	}

	chain output {
		type filter hook output priority filter; policy drop;
		ip saddr 10.4.32.1 ip daddr 10.4.1.50 tcp dport 514 accept
		oifname "ens36.105" udp sport 67 udp dport 68 accept
		oifname "ens36.101" ip daddr 10.4.33.10 udp sport 67 udp dport 67 accept
		oif "lo" accept
		oifname "ens33" ip daddr 172.24.133.80 udp dport { 500, 4500 } accept
		oifname "ens33" ip daddr 172.24.133.80 ip protocol esp accept
		ct state established,related accept
		udp dport 53 accept
		tcp dport 53 accept
		udp dport 123 accept
		tcp dport { 80, 443 } accept
		tcp dport 22 accept
		icmp type { echo-reply, destination-unreachable, echo-request, time-exceeded } accept
		oifname "ens33" ip daddr 172.24.133.76 ip protocol esp accept
		ip daddr 172.24.133.80 udp dport { 500, 4500 } accept
		ip protocol esp ip daddr 172.24.133.80 accept
		limit rate 5/minute burst 5 packets log prefix "OUTPUT-DROP: " level info
		drop
	}
}
table ip nat {
	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		ip saddr 10.4.32.0/20 ip daddr != { 10.4.0.0/19 } oifname "ens33" snat to 172.24.133.84
	}
}
