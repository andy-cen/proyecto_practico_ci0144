table inet filter {
	set lan_ifaces {
		type ifname
		elements = { "ens34.100",
			     "ens34.101",
			     "ens34.102",
			     "ens34.103",
			     "ens34.104",
			     "ens34.105",
			     "ens34.106",
			     "ens34.107",
			     "ens34.108" }
	}

	set management_ifaces {
		type ifname
		elements = { "ens34.100" }
	}

	set internal_server_ifaces {
		type ifname
		elements = { "ens34.101",
			     "ens34.102",
			     "ens34.104" }
	}

	set dmz_ifaces {
		type ifname
		elements = { "ens34.103" }
	}

	set client_ifaces {
		type ifname
		elements = { "ens34.105",
			     "ens34.106",
			     "ens34.107",
			     "ens34.108" }
	}

	set wan_ssh_allow {
		type ipv4_addr
		flags interval
		elements = { 172.17.0.112, 172.17.0.120 }
	}

	set ipsec_peers {
		type ipv4_addr
		elements = { 172.24.133.76, 172.24.133.84 }
	}

	chain input {
		type filter hook input priority filter; policy drop;
		ip saddr { 10.4.5.0-10.4.8.255, 10.4.21.0-10.4.24.255, 10.4.37.0-10.4.40.255 } ip daddr 10.4.16.0/24 counter packets 0 bytes 0 drop
		iif "lo" accept
		ct state established,related accept
		ct state invalid drop
		iifname @client_ifaces ip daddr 10.4.16.0/24 counter packets 4 bytes 336 drop
		iifname "ens35" icmp type { destination-unreachable, echo-request, time-exceeded } accept
		iifname @lan_ifaces icmp type { destination-unreachable, echo-request, time-exceeded } accept
		ip protocol icmp icmp type echo-reply accept
		iifname @lan_ifaces udp dport 123 accept
		iifname "ens33" ip saddr 172.24.133.76 udp dport { 500, 4500 } accept
		iifname "ens33" ip saddr 172.24.133.76 ip protocol esp accept
		iifname "ens33" ip saddr { 10.4.0.0/20, 10.4.32.0/20 } ip daddr 10.4.16.0/20 icmp type echo-request accept
		iifname "ens34.100" tcp dport 22 ct state new accept
		iifname "ens35" tcp dport 22 ct state new accept
		iifname "ens33" ip saddr @wan_ssh_allow tcp dport 22 ct state new limit rate 4/minute burst 4 packets accept
		iifname "ens33" ip saddr @ipsec_peers udp dport { 500, 4500 } accept
		iifname "ens33" ip saddr @ipsec_peers ip protocol esp accept
		iifname "ens34.105" udp sport 68 udp dport 67 accept
		iifname "ens33" ip saddr 10.4.1.10 udp sport 67 udp dport 67 accept
		ip saddr 10.4.1.50 ip daddr 10.4.17.1 tcp dport 9100 ct state new accept
             iifname "ens33" ip saddr 10.4.0.1 ip daddr 10.4.17.1 tcp dport 22 ct state new accept
		limit rate 5/minute burst 5 packets log prefix "INPUT-DROP: " level info
		drop
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
		ip saddr { 10.4.5.0-10.4.8.255, 10.4.21.0-10.4.24.255, 10.4.37.0-10.4.40.255 } ip daddr 10.4.16.0/24 counter packets 0 bytes 0 drop
		ct state established,related accept
		ct state invalid drop
		iifname "ens34.105" oifname "ens34.103" ip saddr 10.4.21.0/24 ip daddr 10.4.19.20 udp dport 53 accept
		iifname "ens34.105" oifname "ens34.103" ip saddr 10.4.21.0/24 ip daddr 10.4.19.20 tcp dport 53 accept
		iifname @client_ifaces oifname @management_ifaces counter packets 0 bytes 0 drop
		iifname @management_ifaces oifname @internal_server_ifaces counter packets 0 bytes 0 accept
		iifname @management_ifaces oifname @dmz_ifaces counter packets 0 bytes 0 accept
		iifname @management_ifaces oifname @client_ifaces counter packets 0 bytes 0 accept
		iifname "ens34.101" oifname "ens34.103" ip saddr 10.4.17.30 ip daddr 10.4.19.20 tcp dport 53 accept
		iifname "ens34.101" oifname "ens34.103" ip saddr 10.4.17.30 ip daddr 10.4.19.20 udp dport 53 accept
		iifname "ens34.101" oifname "ens34.103" ip saddr 10.4.17.30 ip daddr 10.4.19.20 icmp type echo-request accept
		iifname @lan_ifaces oifname "ens33" accept
		iifname @lan_ifaces oifname "ens33" ip daddr 10.4.0.0/20 accept
		iifname "ens33" oifname @lan_ifaces ip saddr 10.4.0.0/20 accept
		iifname "ens33" oifname @lan_ifaces ip saddr { 10.4.0.0/20, 10.4.32.0/20 } accept
		limit rate 5/minute burst 5 packets log prefix "FORWARD-DROP: " level info
		drop
	}

	chain output {
		type filter hook output priority filter; policy drop;
		oif "lo" accept
		oifname "ens33" ip daddr 172.24.133.76 udp dport { 500, 4500 } accept
		oifname "ens33" ip daddr 172.24.133.76 ip protocol esp accept
		ct state established,related accept
		udp dport 53 accept
		tcp dport 53 accept
		udp dport 123 accept
		tcp dport { 80, 443 } accept
		tcp dport 22 accept
		icmp type { echo-reply, destination-unreachable, echo-request, time-exceeded } accept
		oifname "ens33" ip daddr @ipsec_peers udp dport { 500, 4500 } accept
		oifname "ens33" ip daddr @ipsec_peers ip protocol esp accept
		oifname "ens34.101" ip daddr 10.4.17.10 udp dport 67 accept
		oifname "ens33" ip daddr 10.4.1.10 udp dport 67 accept
		ip daddr 10.4.1.50 tcp dport 514 ct state new accept
		limit rate 5/minute burst 5 packets log prefix "OUTPUT-DROP: " level info
		drop
	}
}
table ip nat {
	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		ip saddr 10.4.16.0/20 ip daddr != { 10.4.0.0/20, 10.4.32.0/20 } oifname "ens33" snat to 172.24.133.80
	}
}
